# SMTP — required in production, otherwise verification emails cannot be sent.
# Keep these out of git; set them as env vars on your host.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Geometry Extra <noreply@example.com>

# Seed/claim the "admin" account on first boot (set once, then you can remove it).
# The admin password is hashed at boot, so the env var is not stored in plaintext.
ADMIN_PASSWORD=

# OpenAI API key for the textwithbots chat feature.
# Works with a direct OpenAI key (sk-...) or an OpenRouter key (sk-or-v1-...).
# With OpenRouter, set OPENAI_MODEL to an OpenRouter model id (e.g. openai/gpt-4o-mini, or a :free model).
OPENAI_API_KEY=
OPENAI_MODEL=

# SQLite database location. On Render free tier the disk is wiped on each deploy,
# so for persistent accounts mount a disk and set DB_PATH=/data/gd.db
DB_PATH=./gd.db